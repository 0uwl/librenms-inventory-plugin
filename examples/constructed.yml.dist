# Example second inventory source, chained after librenms.yml, using Ansible's builtin
# `constructed` plugin for property-based grouping and composed vars over the
# `libre_<field>` host vars librenms.yml already set.
#
# Run both together, e.g.: ansible-inventory -v --list -i librenms.yml -i constructed.yml
# `constructed` must be enabled in ansible.cfg's [inventory] enable_plugins - see
# examples/ansible.cfg.example.
plugin: constructed

compose:
  ansible_host: libre_hostname
  ansible_network_os: "{'iosxe': 'ios'}.get(libre_os, libre_os)"

  # Vars parsed out of a hostname naming convention, e.g. ams01-core-sw01 gives site
  # "ams01" and role "core". A hostname that doesn't match leaves the var unset.
  site: libre_hostname | regex_search('^(?P<site>[a-z]+\d+)-', '\g<site>') | first
  role: libre_hostname | regex_search('^[a-z]+\d+-(?P<role>[a-z]+)-', '\g<role>') | first

  # Variables used for creating unique groups based on site and room parsing from
  # SNMP location. libre_location_* variables come from the parse_location_field setting
  # in the plugin file, so see the explaination for that setting in the plugin documentation.
  _site_group: "'site_' ~ libre_location_site"
  _room_group: "'site_' ~ libre_location_site ~ '_room_' ~ libre_location_room"

groups:
  # The variable 'purpose' is referred to as 'description' in the LibreNMS UI
  network_edge: "'router' in libre_purpose | default('')"

keyed_groups:
  - prefix: os
    key: libre_os
  - prefix: location
    key: libre_location

  # site_NYC
  - key: libre_location_site
    prefix: site

  # Nested site -> room -> rack groups from a parsed location (parse_location_field in
  # librenms.yml). Each level's group name is prefixed with its *parent's full
  # name*, so site "NYC" gives site_NYC, and its room "Room2" gives site_NYC_room_Room2.
  # Hosts missing a level (no room, no rack) simply don't get a group at that level
  - key: _room_group
    prefix: ""
    separator: ""
    parent_group: "{{ _site_group }}"

  # site_NYC_room_Room2_rack_RackA (one group per distinct rack in
  # libre_location_positions), nested under the room group above - or directly under
  # the site group, as eg. site_NYC_rack_RackA, for a host with a rack but no room.
  - key: >-
      libre_location_positions
      | map(attribute='rack', default=None)
      | select('string')
      | unique
      | map('regex_replace', '^(.*)$', (_room_group | default(_site_group)) ~ '_rack_\\1')
      | list
    prefix: ""
    separator: ""
    parent_group: "{{ _room_group | default(_site_group) }}"
