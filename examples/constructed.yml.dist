# Example second inventory source, chained after librenms.yml, using Ansible's builtin
# `constructed` plugin for property-based grouping and composed vars over the
# `libre_<field>` host vars librenms.yml already set.
#
# Run both together, e.g.: ansible-inventory -v --list -i librenms.yml -i constructed.yml
# `constructed` must be enabled in ansible.cfg's [inventory] enable_plugins - see
# examples/ansible.cfg.example.
plugin: constructed

# Required for keyed_groups/groups/compose below to see vars that come from
# host_vars/group_vars files (eg. deploy_environment, hand-set per host - see the
# README's Grouping section and scripts/sync_host_vars.py) rather than from librenms.yml
# itself. Without this, constructed only sees vars set directly by inventory plugins.
use_vars_plugins: true

compose:
  ansible_host: libre_hostname
  ansible_network_os: "{'iosxe': 'ios'}.get(libre_os, libre_os)"

groups:
  network_edge: "'router' in libre_purpose | default('')"

keyed_groups:
  - prefix: os
    key: libre_os
  - prefix: location
    key: libre_location
  # deploy_environment isn't a LibreNMS field - it's set manually per host in
  # host_vars/<hostname>.yml, typically stubbed out by scripts/sync_host_vars.py first.
  - prefix: env
    key: deploy_environment
