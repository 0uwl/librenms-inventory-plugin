# Example command line: ansible-inventory -v --list -i librenms.yml
# Remember to export LIBRENMS_TOKEN: export LIBRENMS_TOKEN=abc
plugin: librenms
api_endpoint: https://librenms-host.local/api/v0
validate_certs: true

cache: true
cache_plugin: jsonfile
cache_connection: /tmp/librenms_inventory_cache
cache_timeout: 600

exclude_disabled: true
exclude_ignored: true

# Parse a device's Notes field as YAML and set the result as host vars - see the
# README's Grouping section.
# parse_notes_field: true

# Trim libre_hardware down to a product family so devices can be grouped by family
# instead of by exact product ID - see the README's "Trimming hardware to a product
# family" section. Keyed on the LibreNMS os; first pattern to match wins.
# hardware_trimming_patterns:
#   ios: &cisco_catalyst
#     - '^WS-(C\d+[A-Z]*)'
#     - '^C\d+[A-Z]*'
#   iosxe: *cisco_catalyst
#   nxos:
#     - '^[NC]?\dK-C\d+[A-Z]*'

# Lowercase libre_hardware so it is safe to use directly in group names. Applies whether
# or not the value was trimmed.
# lowercase_hardware: true

group_name_regex_filter:
  - ^group name1$
  - ^group name2$
