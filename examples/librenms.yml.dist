# Example command line: ansible-inventory -v --list -i librenms.yml
# Remember to export LIBRENMS_TOKEN: export LIBRENMS_TOKEN=abc
plugin: librenms
api_endpoint: https://librenms-host.local/api/v0
validate_certs: true

cache: true
cache_plugin: jsonfile
cache_connection: /tmp/librenms_inventory_cache
cache_timeout: 600

exclude_disabled: true
exclude_ignored: true

# Parse a device's Notes field as YAML and set the result as host vars - see the
# README's Grouping section.
# parse_notes_field: true

# Derive libre_hardware_family (and libre_hardware_variant) so devices can be grouped by
# family instead of by exact product ID - see the README's "Trimming hardware to a
# product family" section. libre_hardware itself is left untouched. Keyed on the LibreNMS
# os; first pattern to match wins.
# hardware_trimming_patterns:
#   ios: &cisco_catalyst
#     - '^WS-(C\d+[A-Z]*)'
#     - '^C\d+[A-Z]*'
#   iosxe: *cisco_catalyst
#   nxos:
#     - '^[NC]?\dK-C\d+[A-Z]*'

# Lowercase the derived family and variant so they are safe to use directly in group
# names. Does not affect libre_hardware.
# lowercase_hardware_family: true

group_name_regex_filter:
  - ^group name1$
  - ^group name2$
